<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting configuration for the API.

  `dotnet publish` rewrites the aspNetCore element's arguments and path, so the
  values below are placeholders. Everything else here is preserved.
-->
<configuration>

  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        InProcess hosting: the app runs inside the IIS worker process. Faster
        than OutOfProcess and the right default for a single site per pool.
        stdoutLogEnabled stays false — Serilog already writes structured logs;
        turn it on only to diagnose a startup failure.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\MCLS.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="InProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!--
            Secrets are set per-server, not here. Use the IIS Configuration
            Editor (system.webServer/aspNetCore/environmentVariables) or a
            machine-level environment variable so they stay out of source
            control and out of the deployment package.
          -->
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering>
          <!-- 30 MB, above the 25 MB upload limit so a slightly oversized
               request reaches the app and gets a clear error rather than an
               opaque IIS 404.13. -->
          <requestLimits maxAllowedContentLength="31457280" />
          <hiddenSegments>
            <add segment="appsettings.json" />
            <add segment="appsettings.Development.json" />
            <add segment="logs" />
          </hiddenSegments>
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- Remove the headers that advertise the stack to an attacker. -->
          <remove name="X-Powered-By" />
          <remove name="Server" />
          <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        </customHeaders>
      </httpProtocol>

      <!-- The API returns JSON only; no static file serving is needed. -->
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>

    </system.webServer>
  </location>

</configuration>
